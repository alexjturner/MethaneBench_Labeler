# Imagery data (large NetCDF files; not tracked)
imagery/**/*.nc
imagery/**/*.nc~

# Keep imagery subdirectory structure
!imagery/
!imagery/sentinel2/
!imagery/landsat_89/
!imagery/landsat_45/

# Database (auto-created on startup; may contain user data)
*.db

# Don't include any swap files or temp netCDF files
*.swp
*.nc~

# Python
__pycache__/
*.py[cod]
*.pyo
.env

# Log
app.log

# Upload script
upload_git_data.csh

# pixi environment (large; reproducible from pixi.toml + pixi.lock)
.pixi/

# macOS
.DS_Store

# GEE test pulls and local test databases
imagery_gee/
*.tar.gz
eda_gee_compare/
eda_calibration/
imagery_gee_extra*/
imagery_gee*_compact/
imagery_mars*/
mars_targets/
